{
  "expo": {
    "name": "zChit Owner",
    "slug": "zchit-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/zchit-owner.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      ["expo-splash-screen", {"image": "./assets/zchit-owner.png", "imageWidth": 512, "resizeMode": "contain", "backgroundColor": "#047857"}],
      "expo-secure-store"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zchit.owner"
    },
    "android": {
      "package": "com.zchit.owner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-transparent.png",
        "backgroundImage": "./assets/zchit-owner.png",
        "backgroundColor": "#047857"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/zchit-owner.png"
    }
  }
}
